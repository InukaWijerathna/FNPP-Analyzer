<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FNPPAnalyzer</AssemblyName>
    <RootNamespace>FNPPAnalyzer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="dnYara" Version="2.1.0" />
    <PackageReference Include="dnYara.NativePack" Version="2.1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="YaraRules\**\*.yar*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The test project lives in a subdirectory — exclude it from this project's
       default globs so its sources/items aren't compiled twice. -->
  <ItemGroup>
    <Compile Remove="FNPPAnalyzer.Tests\**\*.cs" />
    <Content Remove="FNPPAnalyzer.Tests\**\*" />
    <None Remove="FNPPAnalyzer.Tests\**\*" />
    <EmbeddedResource Remove="FNPPAnalyzer.Tests\**\*" />
  </ItemGroup>

</Project>
